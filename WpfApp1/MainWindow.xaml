<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="To-Do App" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <TextBox x:Name="TaskInput" Height="20"/>
            
            <StackPanel Orientation="Horizontal">
                <Button Content="Add Task" Click="AddButton_Click" Height="20" Width="500" Margin="0, 7,5,0"/>
                <Button Content="Save Tasks" Click="SaveButton_Click" Height="20" Width="270" Margin="5,7,1,0"/>
            </StackPanel>
            
            <TextBlock x:Name="SaveSuccessfulBox" FontSize="7" Width="270" Margin="510,0,0,0"/>
            <ListBox x:Name="TaskListBox" Height="200"/>
        </StackPanel>
    </Grid>
</Window>
